<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #0f0f13;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.agent.AgentCreateController">
    <children>
        <VBox layoutX="300.0" layoutY="30.0" prefWidth="600.0" spacing="20.0" style="-fx-background-color: #16161e; -fx-background-radius: 12; -fx-border-color: #2a2a35; -fx-border-radius: 12;" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="300.0" AnchorPane.rightAnchor="300.0" AnchorPane.topAnchor="30.0">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Créer un Profil Agent" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                                <Label text="Choisissez un jeu et configurez votre profil." textFill="#8a8a98" />
                            </children>
                        </VBox>
                        <Button fx:id="btnRetour" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-border-color: #444455; -fx-border-radius: 6; -fx-text-fill: white; -fx-cursor: hand;" text="← Retour">
                            <padding>
                                <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
                            </padding>
                        </Button>
                    </children>
                </HBox>

                <HBox style="-fx-background-color: #2a2118; -fx-background-radius: 6; -fx-border-color: #4a3820; -fx-border-radius: 6;">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <Label text="⚠ Après la création, vous ne pourrez modifier que : pseudo, rang, statut et lien social." textFill="#d99846">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="15.0" style="-fx-background-color: #16161e;">
                            <children>

                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Player" textFill="#e0e0e0">
                                            <font><Font name="System Bold" size="12.0" /></font>
                                        </Label>
                                        <ComboBox fx:id="cbPlayer" prefWidth="520.0" promptText="Select a player" style="-fx-background-color: #1e1e28; -fx-border-color: #2a2a35; -fx-border-radius: 6; -fx-background-radius: 6;" stylesheets="@style.css" />
                                    </children>
                                </VBox>

                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Team" textFill="#e0e0e0">
                                            <font><Font name="System Bold" size="12.0" /></font>
                                        </Label>
                                        <ComboBox fx:id="cbTeam" prefWidth="520.0" promptText="No Team (Free Agent)" style="-fx-background-color: #1e1e28; -fx-border-color: #2a2a35; -fx-border-radius: 6; -fx-background-radius: 6;" />
                                    </children>
                                </VBox>

                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Pseudo" textFill="#e0e0e0">
                                            <font><Font name="System Bold" size="12.0" /></font>
                                        </Label>
                                        <TextField fx:id="tfPseudo" style="-fx-background-color: #1e1e28; -fx-text-fill: white; -fx-border-color: #2a2a35; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10;" />
                                    </children>
                                </VBox>

                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Game" textFill="#e0e0e0">
                                            <font><Font name="System Bold" size="12.0" /></font>
                                        </Label>
                                        <ComboBox fx:id="cbGame" prefWidth="520.0" promptText="Choose a game" style="-fx-background-color: #1e1e28; -fx-border-color: #2a2a35; -fx-border-radius: 6; -fx-background-radius: 6;" />
                                    </children>
                                </VBox>

                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Rank" textFill="#e0e0e0">
                                            <font><Font name="System Bold" size="12.0" /></font>
                                        </Label>
                                        <TextField fx:id="tfRank" style="-fx-background-color: #1e1e28; -fx-text-fill: white; -fx-border-color: #2a2a35; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10;" />
                                    </children>
                                </VBox>

                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Status" textFill="#e0e0e0">
                                            <font><Font name="System Bold" size="12.0" /></font>
                                        </Label>
                                        <ComboBox fx:id="cbStatus" prefWidth="520.0" promptText="Select status" style="-fx-background-color: #1e1e28; -fx-border-color: #2a2a35; -fx-border-radius: 6; -fx-background-radius: 6;" />
                                    </children>
                                </VBox>

                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Socials link" textFill="#e0e0e0">
                                            <font><Font name="System Bold" size="12.0" /></font>
                                        </Label>
                                        <TextField fx:id="tfSocials" style="-fx-background-color: #1e1e28; -fx-text-fill: white; -fx-border-color: #2a2a35; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 10;" />
                                    </children>
                                </VBox>

                            </children>
                        </VBox>
                    </content>
                </ScrollPane>

                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Button fx:id="btnAnnuler" mnemonicParsing="false" style="-fx-background-color: #1e1e28; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="Annuler">
                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                        </Button>
                        <Button fx:id="btnCreer" mnemonicParsing="false" style="-fx-background-color: #ff3b3f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="+ Créer">
                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                        </Button>
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>