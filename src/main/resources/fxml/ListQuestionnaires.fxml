<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #0f0f13;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.questionnaire.ListQuestionnairesController">
    <children>
        <VBox spacing="25.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="30.0">
            <children>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Gestion des Questionnaires" textFill="WHITE">
                                    <font><Font name="System Bold" size="24.0" /></font>
                                </Label>
                                <Label text="Liste des templates par jeu" textFill="#8a8a98" />
                            </children>
                        </VBox>
                        <Button fx:id="btnNouveau" mnemonicParsing="false" style="-fx-background-color: #00ffff; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="+ Nouveau">
                            <padding><Insets bottom="10.0" left="20.0" right="20.0" top="10.0" /></padding>
                        </Button>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #16161e; -fx-background-radius: 8; -fx-border-color: #2a2a35; -fx-border-radius: 8; -fx-padding: 5 15;" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="🔍" textFill="#8a8a98" />
                                <TextField fx:id="tfSearch" promptText="Rechercher un jeu..." style="-fx-background-color: transparent; -fx-text-fill: white;" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <TableView fx:id="questionnaireTable" style="-fx-background-color: #16161e; -fx-border-color: #2a2a35; -fx-border-radius: 8; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" style="-fx-alignment: center;" text="ID" />
                        <TableColumn fx:id="colGame" prefWidth="250.0" text="Jeu" />
                        <TableColumn fx:id="colQ1" prefWidth="350.0" text="Question Principale (Q1)" />
                        <TableColumn fx:id="colActions" prefWidth="300.0" style="-fx-alignment: center;" text="Actions" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

            </children>
        </VBox>
    </children>
</AnchorPane>