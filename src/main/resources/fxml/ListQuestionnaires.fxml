<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.web.WebView?>

<HBox stylesheets="@../css/dark-theme.css" prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #0f0f13;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.questionnaire.ListQuestionnairesController">
    <children>

        <VBox prefWidth="250.0" spacing="40.0" style="-fx-background-color: #1a1a24; -fx-border-color: #2a2a35; -fx-border-width: 0 1 0 0;">
            <padding><Insets bottom="30.0" left="20.0" right="20.0" top="40.0" /></padding>
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="PHANTOM" textFill="#00ffff"><font><Font name="System Bold" size="24.0" /></font></Label>
                        <Label text="ADMIN PANEL" textFill="WHITE"><font><Font name="System Bold" size="14.0" /></font></Label>
                    </children>
                </VBox>
                <Button fx:id="btnExportCSV" mnemonicParsing="false" style="-fx-background-color: #2dff8b; -fx-text-fill: black; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6;" text="📥 Exporter CSV">
                    <padding><Insets bottom="10.0" left="20.0" right="20.0" top="10.0" /></padding>
                </Button>

                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Button fx:id="btnNavAgents" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #8a8a98; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="👥 Agents">
                            <font><Font size="16.0" /></font>
                            <padding><Insets bottom="12.0" left="15.0" top="12.0" /></padding>
                        </Button>

                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #2a2a35; -fx-border-color: #00ffff; -fx-border-width: 0 0 0 4; -fx-text-fill: #00ffff; -fx-alignment: CENTER_LEFT; -fx-cursor: default;" text="📝 Questionnaires">
                            <font><Font name="System Bold" size="16.0" /></font>
                            <padding><Insets bottom="12.0" left="11.0" top="12.0" /></padding>
                        </Button>
                    </children>
                </VBox>

                <Button fx:id="btnDisconnect" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #ff3b3f; -fx-cursor: hand;" text="🚪 Déconnexion">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
            </children>
        </VBox>

        <VBox spacing="25.0" style="-fx-padding: 30 50 30 50;" HBox.hgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Dashboard &amp; Questionnaires" textFill="WHITE"><font><Font name="System Bold" size="24.0" /></font></Label>
                                <Label text="Statistiques en temps réel et gestion des modèles" textFill="#8a8a98" />
                            </children>
                        </VBox>
                        <Button fx:id="btnNouveau" mnemonicParsing="false" style="-fx-background-color: #00ffff; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="+ Nouveau">
                            <padding><Insets bottom="10.0" left="20.0" right="20.0" top="10.0" /></padding>
                        </Button>
                    </children>
                </HBox>

                <HBox spacing="20.0" prefHeight="180.0">
                    <children>
                        <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #16161e; -fx-background-radius: 8; -fx-border-color: #2a2a35; -fx-border-radius: 8; -fx-padding: 20;" HBox.hgrow="ALWAYS">
                            <Label text="TOTAL AGENTS" textFill="#8a8a98"><font><Font name="System Bold" size="12.0" /></font></Label>
                            <Label fx:id="lblTotalAgents" text="0" textFill="WHITE"><font><Font name="System Bold" size="36.0" /></font></Label>
                        </VBox>

                        <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #16161e; -fx-background-radius: 8; -fx-border-color: #2a2a35; -fx-border-radius: 8; -fx-padding: 20;" HBox.hgrow="ALWAYS">
                            <Label text="RÉPONSES REÇUES" textFill="#8a8a98"><font><Font name="System Bold" size="12.0" /></font></Label>
                            <Label fx:id="lblCompleted" text="0" textFill="#00ffff"><font><Font name="System Bold" size="36.0" /></font></Label>
                        </VBox>

                        <VBox alignment="CENTER" style="-fx-background-color: #16161e; -fx-background-radius: 8; -fx-border-color: #2a2a35; -fx-border-radius: 8; -fx-padding: 5;" HBox.hgrow="ALWAYS" prefWidth="300.0">
                            <WebView fx:id="chartWebView" prefHeight="160.0" prefWidth="280.0" />
                        </VBox>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #16161e; -fx-background-radius: 8; -fx-border-color: #2a2a35; -fx-border-radius: 8; -fx-padding: 5 15;" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="🔍" textFill="#8a8a98" />
                                <TextField fx:id="tfSearch" promptText="Rechercher un jeu..." style="-fx-background-color: transparent; -fx-text-fill: white;" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <TableView fx:id="questionnaireTable" style="-fx-background-color: #16161e; -fx-border-color: #2a2a35; -fx-border-radius: 8; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colGame" prefWidth="250.0" text="Jeu" sortType="ASCENDING" />
                        <TableColumn fx:id="colQ1" prefWidth="350.0" text="Question Principale (Q1)" />
                        <TableColumn fx:id="colActions" prefWidth="300.0" style="-fx-alignment: center;" text="Actions" />
                    </columns>
                    <sortOrder>
                        <fx:reference source="colGame" />
                    </sortOrder>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

            </children>
        </VBox>

    </children>
</HBox>