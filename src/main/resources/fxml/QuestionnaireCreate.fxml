<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane stylesheets="@../css/dark-theme.css" prefHeight="800.0" prefWidth="1200.0" styleClass="dashboard-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.questionnaire.QuestionnaireCreateController">
    <children>
        <VBox layoutX="250.0" layoutY="50.0" prefWidth="700.0" spacing="20.0" styleClass="module-card" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="250.0" AnchorPane.rightAnchor="250.0" AnchorPane.topAnchor="50.0">
            <padding><Insets bottom="30.0" left="40.0" right="40.0" top="30.0" /></padding>
            <children>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Nouveau Questionnaire" textFill="WHITE"><font><Font name="System Bold" size="24.0" /></font></Label>
                                <Label text="Création d'un template pour un nouveau jeu" styleClass="info-label" />
                            </children>
                        </VBox>
                        <Button fx:id="btnRetour" mnemonicParsing="false" styleClass="secondary-button" text="← Retour">
                            <padding><Insets bottom="8.0" left="15.0" right="15.0" top="8.0" /></padding>
                        </Button>
                    </children>
                </HBox>

                <VBox spacing="15.0">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Nom du Jeu (Obligatoire)" styleClass="form-label" />
                                <TextField fx:id="tfGame" promptText="Ex: Overwatch 2" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Question 1 (Obligatoire)" styleClass="form-label" />
                                <TextField fx:id="tfQ1" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Question 2 (Obligatoire)" styleClass="form-label" />
                                <TextField fx:id="tfQ2" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Question 3 (Optionnelle)" styleClass="form-label" />
                                <TextField fx:id="tfQ3" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Question 4 (Optionnelle)" styleClass="form-label" />
                                <TextField fx:id="tfQ4" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Button fx:id="btnCreer" mnemonicParsing="false" styleClass="action-button" text="Créer le template">
                            <padding><Insets bottom="10.0" left="20.0" right="20.0" top="10.0" /></padding>
                        </Button>
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>