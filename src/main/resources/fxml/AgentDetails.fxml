<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane stylesheets="@../home/home.css" styleClass="home-container" prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.agent.AgentDetailsController">
    <children>
        <HBox layoutX="30.0" layoutY="30.0" prefHeight="640.0" prefWidth="940.0" spacing="30.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
            <children>

                <VBox prefWidth="450.0" spacing="20.0" styleClass="activity-section">
                    <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                    </padding>
                    <children>

                        <Button fx:id="btnRetour" mnemonicParsing="false" styleClass="secondary-button" text="← Retour" />

                        <Label text="Détails de l'Agent" styleClass="section-title" />

                        <GridPane hgap="20.0" vgap="20.0">
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <children>
                                        <Label text="PSEUDO" styleClass="form-label" />
                                        <Label fx:id="lblPseudo" text="-" textFill="WHITE"><font><Font name="System Bold" size="16.0" /></font></Label>
                                    </children>
                                </VBox>
                                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <children>
                                        <Label text="JEU" styleClass="form-label" />
                                        <Label fx:id="lblJeu" text="-" textFill="WHITE"><font><Font name="System Bold" size="16.0" /></font></Label>
                                    </children>
                                </VBox>
                                <VBox GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <children>
                                        <Label text="RANG" styleClass="form-label" />
                                        <Label fx:id="lblRang" text="-" textFill="WHITE"><font><Font name="System Bold" size="16.0" /></font></Label>
                                    </children>
                                </VBox>
                                <VBox GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <children>
                                        <Label text="STATUT" styleClass="form-label" />
                                        <Label fx:id="lblStatut" text="-" textFill="#ff2d2d"><font><Font name="System Bold" size="16.0" /></font></Label>
                                    </children>
                                </VBox>
                                <VBox GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <children>
                                        <Label text="CRÉÉ LE" styleClass="form-label" />
                                        <Label fx:id="lblDate" text="-" textFill="WHITE"><font><Font name="System Bold" size="16.0" /></font></Label>
                                    </children>
                                </VBox>
                            </children>
                        </GridPane>

                        <VBox style="-fx-background-color: rgba(30, 30, 40, 0.6); -fx-background-radius: 8; -fx-padding: 15; -fx-border-color: rgba(255, 45, 45, 0.15); -fx-border-radius: 8;">
                            <children>
                                <Label text="LIEN SOCIAL" styleClass="form-label" />
                                <Label fx:id="lblLien" text="-" textFill="#ff5e5e" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <VBox prefWidth="460.0" spacing="20.0" styleClass="activity-section" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                    </padding>
                    <children>
                        <Label text="Questionnaire" styleClass="section-title" />

                        <VBox fx:id="aiBanner" alignment="CENTER" managed="false" spacing="12.0" style="-fx-background-color: #121218; -fx-border-color: #1e1e28; -fx-border-radius: 8; -fx-background-radius: 8;" visible="false">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <Label text="🤖" textFill="#4f545c">
                                    <font>
                                        <Font size="28.0" />
                                    </font>
                                </Label>
                                <Label text="Get professional feedback on all 4 questions." textFill="#8a8a98">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                                <Button fx:id="btnRunAi" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #ff3b3f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="✨ Run AI Analysis">
                                    <padding>
                                        <Insets bottom="10.0" top="10.0" />
                                    </padding>
                                </Button>
                            </children>
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>
                        </VBox>
                        <ScrollPane fitToWidth="true" styleClass="home-scroll" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="qaContainer" spacing="15.0" style="-fx-background-color: transparent;" />
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>

            </children>
        </HBox>
    </children>
</AnchorPane>