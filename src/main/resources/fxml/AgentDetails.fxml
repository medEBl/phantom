<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #121216;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.agent.AgentDetailsController">
    <children>
        <HBox layoutX="30.0" layoutY="30.0" prefHeight="640.0" prefWidth="940.0" spacing="30.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
            <children>

                <VBox prefWidth="450.0" spacing="20.0" style="-fx-background-color: #1a1a24; -fx-background-radius: 12; -fx-border-color: #2a2a36; -fx-border-radius: 12;">
                    <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                    </padding>
                    <children>

                        <Button fx:id="btnRetour" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-border-color: #444455; -fx-border-radius: 6; -fx-text-fill: white; -fx-cursor: hand;" text="← Retour" />

                        <Label text="Détails de l'Agent" textFill="WHITE">
                            <font><Font name="System Bold" size="20.0" /></font>
                        </Label>

                        <GridPane hgap="20.0" vgap="20.0">
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="50.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <children>
                                        <Label text="PSEUDO" textFill="#a0a0a0"><font><Font size="10.0" /></font></Label>
                                        <Label fx:id="lblPseudo" text="-" textFill="WHITE"><font><Font name="System Bold" size="16.0" /></font></Label>
                                    </children>
                                </VBox>
                                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <children>
                                        <Label text="JEU" textFill="#a0a0a0"><font><Font size="10.0" /></font></Label>
                                        <Label fx:id="lblJeu" text="-" textFill="WHITE"><font><Font name="System Bold" size="16.0" /></font></Label>
                                    </children>
                                </VBox>
                                <VBox GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <children>
                                        <Label text="RANG" textFill="#a0a0a0"><font><Font size="10.0" /></font></Label>
                                        <Label fx:id="lblRang" text="-" textFill="WHITE"><font><Font name="System Bold" size="16.0" /></font></Label>
                                    </children>
                                </VBox>
                                <VBox GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <children>
                                        <Label text="STATUT" textFill="#a0a0a0"><font><Font size="10.0" /></font></Label>
                                        <Label fx:id="lblStatut" text="-" textFill="#ff4444"><font><Font name="System Bold" size="16.0" /></font></Label>
                                    </children>
                                </VBox>
                                <VBox GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <children>
                                        <Label text="CRÉÉ LE" textFill="#a0a0a0"><font><Font size="10.0" /></font></Label>
                                        <Label fx:id="lblDate" text="-" textFill="WHITE"><font><Font name="System Bold" size="16.0" /></font></Label>
                                    </children>
                                </VBox>
                            </children>
                        </GridPane>

                        <VBox style="-fx-background-color: #22222d; -fx-background-radius: 8; -fx-padding: 15;">
                            <children>
                                <Label text="LIEN SOCIAL" textFill="#a0a0a0"><font><Font size="10.0" /></font></Label>
                                <Label fx:id="lblLien" text="-" textFill="#4499ff" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <VBox prefWidth="460.0" spacing="20.0" style="-fx-background-color: #1a1a24; -fx-background-radius: 12; -fx-border-color: #2a2a36; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                    </padding>
                    <children>
                        <Label text="Questionnaire" textFill="WHITE">
                            <font><Font name="System Bold" size="20.0" /></font>
                        </Label>

                        <ScrollPane fitToWidth="true" style="-fx-background: #1a1a24; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="qaContainer" spacing="15.0" />
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>

            </children>
        </HBox>
    </children>
</AnchorPane>