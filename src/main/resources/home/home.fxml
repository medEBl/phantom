<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane style="-fx-background-color: #0a0a0a;" prefWidth="1920" prefHeight="1080" maxWidth="Infinity" maxHeight="Infinity" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.home.HomeController">
   <top>
      <VBox style="-fx-background-color: linear-gradient(to bottom, #8b0000, #4a0000); -fx-padding: 0;">
         <children>
            <!-- Header with app title and user actions -->
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 15 25; -fx-background-color: rgba(0,0,0,0.3);">
               <children>
                  <Text style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #ff3333; -fx-font-family: 'Arial Black';" text="PHANTOM" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="userLabel" style="-fx-font-size: 14px; -fx-fill: #cccccc; -fx-font-weight: bold;" text="Welcome, User" />
                  <Button fx:id="editProfileButton" onAction="#handleEditProfile" style="-fx-background-color: #ff3333; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-border-color: #cc0000; -fx-border-width: 2;" text="Edit Profile" />
                  <Button fx:id="logoutButton" onAction="#handleLogout" style="-fx-background-color: #4a0000; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-border-color: #8b0000; -fx-border-width: 2;" text="Logout" />
               </children>
            </HBox>
            
            <!-- Navigation Bar -->
            <HBox alignment="CENTER" spacing="0" style="-fx-background-color: #1a1a1a; -fx-padding: 0;">
               <children>
                  <Button fx:id="navHome" onAction="#handleNavHome" style="-fx-background-color: transparent; -fx-text-fill: #ff3333; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 16px; -fx-border-color: transparent; -fx-border-width: 0 2 0 0; -fx-border-color: #333333; -fx-padding: 15 30;" text="HOME" />
                  <Button fx:id="navTournaments" onAction="#handleTournaments" style="-fx-background-color: transparent; -fx-text-fill: #cccccc; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 16px; -fx-border-color: transparent; -fx-border-width: 0 2 0 0; -fx-border-color: #333333; -fx-padding: 15 30;" text="TOURNAMENTS" />
                  <Button fx:id="navTeams" onAction="#handleTeams" style="-fx-background-color: transparent; -fx-text-fill: #cccccc; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 16px; -fx-border-color: transparent; -fx-border-width: 0 2 0 0; -fx-border-color: #333333; -fx-padding: 15 30;" text="TEAMS" />
                  <Button fx:id="navTraining" onAction="#handleTraining" style="-fx-background-color: transparent; -fx-text-fill: #cccccc; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 16px; -fx-border-color: transparent; -fx-border-width: 0 2 0 0; -fx-border-color: #333333; -fx-padding: 15 30;" text="TRAINING" />
                  <Button fx:id="navShop" onAction="#handleShop" style="-fx-background-color: transparent; -fx-text-fill: #cccccc; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 16px; -fx-border-color: transparent; -fx-border-width: 0 2 0 0; -fx-border-color: #333333; -fx-padding: 15 30;" text="SHOP" />
                  <Button fx:id="navMatchy" onAction="#handleMatchy" style="-fx-background-color: transparent; -fx-text-fill: #cccccc; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 16px; -fx-border-color: transparent; -fx-border-width: 0 2 0 0; -fx-border-color: #333333; -fx-padding: 15 30;" text="MATCHY" />
                  <Button fx:id="navAgent" onAction="#handleAgent" style="-fx-background-color: transparent; -fx-text-fill: #cccccc; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 15 30;" text="AGENT" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   
   <center>
      <VBox alignment="CENTER" spacing="30" style="-fx-padding: 40; -fx-background-color: #0a0a0a;">
         <children>
            <Text fx:id="welcomeText" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: #ff3333; -fx-font-family: 'Arial Black';" text="WELCOME TO PHANTOM" />
            
            <Text fx:id="roleText" style="-fx-font-size: 18px; -fx-fill: #cccccc; -fx-font-weight: bold;" text="ROLE: PLAYER" />
            
            <GridPane hgap="25" vgap="20" style="-fx-background-color: #1a1a1a; -fx-padding: 40; -fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #8b0000; -fx-border-width: 2;">
               <children>
                  <Button fx:id="profileButton" onAction="#handleProfile" prefHeight="60" prefWidth="220" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-background-color: #8b0000; -fx-text-fill: white; -fx-cursor: hand; -fx-border-color: #ff3333; -fx-border-width: 2; -fx-font-family: 'Arial Black';" text="MY PROFILE" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                  
                  <Button fx:id="tournamentButton" onAction="#handleTournaments" prefHeight="60" prefWidth="220" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-background-color: #4a0000; -fx-text-fill: white; -fx-cursor: hand; -fx-border-color: #8b0000; -fx-border-width: 2; -fx-font-family: 'Arial Black';" text="TOURNAMENTS" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  
                  <Button fx:id="teamButton" onAction="#handleTeams" prefHeight="60" prefWidth="220" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-background-color: #4a0000; -fx-text-fill: white; -fx-cursor: hand; -fx-border-color: #8b0000; -fx-border-width: 2; -fx-font-family: 'Arial Black';" text="TEAMS" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                  
                  <Button fx:id="trainingButton" onAction="#handleTraining" prefHeight="60" prefWidth="220" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-background-color: #4a0000; -fx-text-fill: white; -fx-cursor: hand; -fx-border-color: #8b0000; -fx-border-width: 2; -fx-font-family: 'Arial Black';" text="TRAINING" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <Button fx:id="shopButton" onAction="#handleShop" prefHeight="60" prefWidth="220" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-background-color: #4a0000; -fx-text-fill: white; -fx-cursor: hand; -fx-border-color: #8b0000; -fx-border-width: 2; -fx-font-family: 'Arial Black';" text="SHOP" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                  
                  <Button fx:id="matchyButton" onAction="#handleMatchy" prefHeight="60" prefWidth="220" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-background-color: #4a0000; -fx-text-fill: white; -fx-cursor: hand; -fx-border-color: #8b0000; -fx-border-width: 2; -fx-font-family: 'Arial Black';" text="MATCHY" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                  
                  <Button fx:id="agentButton" onAction="#handleAgent" prefHeight="60" prefWidth="220" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-background-color: #4a0000; -fx-text-fill: white; -fx-cursor: hand; -fx-border-color: #8b0000; -fx-border-width: 2; -fx-font-family: 'Arial Black';" text="AGENT" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               </children>
               <columnConstraints>
                  <ColumnConstraints />
                  <ColumnConstraints />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
            </GridPane>
            
            <VBox spacing="15" alignment="CENTER" style="-fx-background-color: #1a1a1a; -fx-padding: 30; -fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #8b0000; -fx-border-width: 2;">
               <children>
                  <Text style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #ff3333; -fx-font-family: 'Arial Black';" text="BATTLE STATS" />
                  <HBox spacing="40" alignment="CENTER">
                     <children>
                        <VBox alignment="CENTER" spacing="8">
                           <children>
                              <Text fx:id="pointsText" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #ff3333; -fx-font-family: 'Arial Black';" text="0" />
                              <Text style="-fx-font-size: 14px; -fx-fill: #cccccc; -fx-font-weight: bold;" text="POINTS" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="8">
                           <children>
                              <Text fx:id="tournamentsText" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #ff3333; -fx-font-family: 'Arial Black';" text="0" />
                              <Text style="-fx-font-size: 14px; -fx-fill: #cccccc; -fx-font-weight: bold;" text="BATTLES" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="8">
                           <children>
                              <Text fx:id="teamsText" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: #ff3333; -fx-font-family: 'Arial Black';" text="0" />
                              <Text style="-fx-font-size: 14px; -fx-fill: #cccccc; -fx-font-weight: bold;" text="SQUADS" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
