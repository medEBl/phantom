<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import java.net.*?>

<BorderPane styleClass="profile-container" prefWidth="1920" prefHeight="1080" maxWidth="Infinity" maxHeight="Infinity" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.user.ProfileController">
   <stylesheets>
      <URL value="@/user/css/style.css" />
   </stylesheets>
      <top>
      <VBox styleClass="profile-header">
         <children>
            <!-- Header with navigation and user actions -->
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="profile-info">
               <children>
                  <Button fx:id="backButton" onAction="#handleBack" styleClass="login-button" text="BACK" />
                  <Text styleClass="profile-title" text="SOLDIER PROFILE" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="editButton" onAction="#handleEdit" styleClass="update-button" text="EDIT PROFILE" />
               </children>
            </HBox>
            
            <!-- Navigation Bar -->
            <HBox alignment="CENTER" spacing="0" styleClass="profile-info">
               <children>
                  <Button fx:id="navHome" onAction="#handleBack" styleClass="profile-link" text="HOME" />
                  <Button fx:id="navProfile" styleClass="profile-link" text="PROFILE" />
                  <Button fx:id="navTournaments" onAction="#handleTournaments" styleClass="profile-link" text="TOURNAMENTS" />
                  <Button fx:id="navTeams" onAction="#handleTeams" styleClass="profile-link" text="TEAMS" />
                  <Button fx:id="navTraining" onAction="#handleTraining" styleClass="profile-link" text="TRAINING" />
                  <Button fx:id="navShop" onAction="#handleShop" styleClass="profile-link" text="SHOP" />
                  <Button fx:id="navMatchy" onAction="#handleMatchy" styleClass="profile-link" text="MATCHY" />
                  <Button fx:id="navAgent" onAction="#handleAgent" styleClass="profile-link" text="AGENT" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   
   <center>
      <VBox alignment="CENTER" spacing="30">
         <children>
            <Text styleClass="profile-title" text="SOLDIER DATA" />
            
            <VBox spacing="20" styleClass="profile-info" maxWidth="500">
               <children>
                  <GridPane hgap="20" vgap="15">
                     <children>
                        <Label styleClass="form-label" text="CALLSIGN:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label fx:id="fullNameLabel" styleClass="label" text="LOADING..." GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        
                        <Label styleClass="form-label" text="COMMS CHANNEL:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="emailLabel" styleClass="label" text="LOADING..." GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        
                        <Label styleClass="form-label" text="SQUAD TAG:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <Label fx:id="usernameLabel" styleClass="label" text="LOADING..." GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        
                        <Label styleClass="form-label" text="RANK:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <Label fx:id="roleLabel" styleClass="label" text="LOADING..." GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        
                        <Label styleClass="form-label" text="REGION:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <Label fx:id="countryLabel" styleClass="label" text="LOADING..." GridPane.columnIndex="1" GridPane.rowIndex="4" />
                        
                        <Label styleClass="form-label" text="ENLISTMENT DATE:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                        <Label fx:id="birthDateLabel" styleClass="label" text="LOADING..." GridPane.columnIndex="1" GridPane.rowIndex="5" />
                        
                        <Label styleClass="form-label" text="COMBAT POINTS:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                        <Label fx:id="pointsLabel" styleClass="label" text="LOADING..." GridPane.columnIndex="1" GridPane.rowIndex="6" />
                        
                        <Label styleClass="form-label" text="DUTY STATUS:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                        <Label fx:id="activeStatusLabel" styleClass="label" text="LOADING..." GridPane.columnIndex="1" GridPane.rowIndex="7" />
                     </children>
                     <columnConstraints>
                        <ColumnConstraints />
                        <ColumnConstraints />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>
                  </GridPane>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
