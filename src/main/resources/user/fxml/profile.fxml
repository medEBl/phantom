<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.user.ProfileController">
   <top>
      <VBox style="-fx-background-color: #2c3e50; -fx-padding: 15;">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 0 20;">
               <children>
                  <Button fx:id="backButton" onAction="#handleBack" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;" text="← Back" />
                  <Text style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: white;" text="My Profile" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="editButton" onAction="#handleEdit" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;" text="Edit Profile" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   
   <center>
      <VBox alignment="CENTER" spacing="20" style="-fx-padding: 40;">
         <children>
            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 30; -fx-border-radius: 10; -fx-background-radius: 10;" maxWidth="400">
               <children>
                  <Text style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #2c3e50;" text="Profile Information" />
                  
                  <GridPane hgap="15" vgap="10">
                     <children>
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #555;" text="Full Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label fx:id="fullNameLabel" style="-fx-font-size: 14px; -fx-fill: #2c3e50;" text="Loading..." GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #555;" text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="emailLabel" style="-fx-font-size: 14px; -fx-fill: #2c3e50;" text="Loading..." GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #555;" text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <Label fx:id="usernameLabel" style="-fx-font-size: 14px; -fx-fill: #2c3e50;" text="Loading..." GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #555;" text="Role:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <Label fx:id="roleLabel" style="-fx-font-size: 14px; -fx-fill: #2c3e50;" text="Loading..." GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #555;" text="Country:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <Label fx:id="countryLabel" style="-fx-font-size: 14px; -fx-fill: #2c3e50;" text="Loading..." GridPane.columnIndex="1" GridPane.rowIndex="4" />
                        
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #555;" text="Birth Date:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                        <Label fx:id="birthDateLabel" style="-fx-font-size: 14px; -fx-fill: #2c3e50;" text="Loading..." GridPane.columnIndex="1" GridPane.rowIndex="5" />
                        
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #555;" text="Achievement Points:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                        <Label fx:id="pointsLabel" style="-fx-font-size: 14px; -fx-fill: #3498db; -fx-font-weight: bold;" text="Loading..." GridPane.columnIndex="1" GridPane.rowIndex="6" />
                        
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #555;" text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
                        <Label fx:id="activeStatusLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Loading..." GridPane.columnIndex="1" GridPane.rowIndex="7" />
                     </children>
                     <columnConstraints>
                        <ColumnConstraints />
                        <ColumnConstraints />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>
                  </GridPane>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
