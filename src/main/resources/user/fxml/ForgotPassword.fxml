<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="Controllers.user.ForgotPasswordController"
           stylesheets="@/user/css/auth.css"
           prefWidth="480" prefHeight="580">

    <!-- Dark background -->
    <VBox alignment="CENTER" styleClass="auth-root">

        <!-- Card -->
        <VBox styleClass="auth-card" alignment="CENTER" spacing="0">

            <!-- Logo / Title -->
            <Label text="PHANTOM" styleClass="brand-title"/>
            <Label text="FORCE"   styleClass="brand-sub"/>

            <Region prefHeight="20"/>

            <!-- Step indicator -->
            <HBox alignment="CENTER" spacing="8">
                <Label fx:id="stepLabel" text="Step 1 of 2 — Enter your email"
                       styleClass="step-label"/>
            </HBox>

            <Region prefHeight="24"/>

            <!-- ── STEP 1 : Email form ── -->
            <VBox fx:id="stepEmailPane" spacing="14" alignment="CENTER_LEFT">

                <Label text="Email address" styleClass="field-label"/>
                <TextField fx:id="emailField"
                           promptText="you@example.com"
                           styleClass="auth-field"/>
                <Label fx:id="emailError" styleClass="error-label" text="" wrapText="true"/>

                <Region prefHeight="8"/>

                <Button fx:id="sendBtn"
                        text="Send Reset Link"
                        styleClass="primary-btn"
                        onAction="#onSendLink"
                        maxWidth="Infinity"/>

                <Label fx:id="successMsg" styleClass="success-label"
                       text="" wrapText="true" managed="false" visible="false"/>
            </VBox>

            <!-- ── STEP 2 : New password form ── -->
            <VBox fx:id="stepResetPane" spacing="14" alignment="CENTER_LEFT"
                  managed="false" visible="false">

                <Label text="New password" styleClass="field-label"/>
                <PasswordField fx:id="newPasswordField"
                               promptText="Min 8 chars, uppercase, number, symbol"
                               styleClass="auth-field"/>

                <Label text="Confirm password" styleClass="field-label"/>
                <PasswordField fx:id="confirmPasswordField"
                               promptText="Repeat your new password"
                               styleClass="auth-field"/>

                <Label fx:id="resetError" styleClass="error-label" text="" wrapText="true"/>

                <Region prefHeight="8"/>

                <Button text="Set New Password"
                        styleClass="primary-btn"
                        onAction="#onResetPassword"
                        maxWidth="Infinity"/>
            </VBox>

            <!-- ── STEP 2.5 : Enter codes from email ── -->
            <VBox fx:id="stepCodesPane" visible="false" managed="false" spacing="12">
                <Label text="SELECTOR CODE" styleClass="field-label"/>
                <TextField fx:id="selectorField" promptText="Paste selector from email" styleClass="auth-field"/>

                <Label text="TOKEN CODE" styleClass="field-label"/>
                <TextField fx:id="tokenField" promptText="Paste token from email" styleClass="auth-field"/>

                <Label fx:id="codesError" styleClass="error-label" text=""/>

                <Button text="VERIFY CODES" styleClass="primary-btn"
                        maxWidth="Infinity" onAction="#onVerifyCodes"/>
            </VBox>

            <Region prefHeight="20"/>

            <!-- Back to login -->
            <HBox alignment="CENTER">
                <Hyperlink text="← Back to Login"
                           styleClass="link-btn"
                           onAction="#onBackToLogin"/>
            </HBox>

        </VBox>
    </VBox>
</StackPane>
