<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<BorderPane styleClass="delete-team-container" prefWidth="400" prefHeight="300" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.team.TeamDeleteController">
   <stylesheets>
      <URL value="@/team/css/teams.css" />
   </stylesheets>

   <top>
      <VBox styleClass="delete-header" spacing="10">
         <children>
            <Text styleClass="delete-title" text="Delete Team" />
         </children>
         <padding>
            <Insets top="20" right="20" bottom="10" left="20" />
         </padding>
      </VBox>
   </top>

   <center>
      <VBox styleClass="delete-form" spacing="20" alignment="CENTER">
         <children>
            <Text styleClass="delete-message" text="Are you sure you want to delete this team?" wrapText="true" />
            <Text fx:id="teamNameText" styleClass="delete-team-name" text="Team Name" />
            <Text styleClass="delete-warning" text="This action cannot be undone!" />
         </children>
         <padding>
            <Insets top="20" right="40" bottom="20" left="40" />
         </padding>
      </VBox>
   </center>

   <bottom>
      <HBox alignment="CENTER" spacing="15" styleClass="delete-actions">
         <children>
            <Button fx:id="cancelButton" onAction="#handleCancel" styleClass="secondary-button" text="Cancel" prefWidth="100" />
            <Button fx:id="confirmButton" onAction="#handleConfirm" styleClass="danger-button" text="Delete Team" prefWidth="120" />
         </children>
         <padding>
            <Insets top="20" right="20" bottom="20" left="20" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
