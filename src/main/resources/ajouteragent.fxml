<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>

<Accordion maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25">
    <panes>
        <!-- Pseudo Input Section -->
        <TitledPane animated="false" text="Pseudo">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="500.0">
                    <VBox spacing="10" layoutX="20" layoutY="20">
                        <HBox spacing="10">
                            <Label text="Pseudo:" />
                            <TextField fx:id="pseudoField" promptText="Enter pseudo" prefWidth="200" />
                        </HBox>
                    </VBox>
                </AnchorPane>
            </content>
        </TitledPane>

        <!-- Game Input Section -->
        <TitledPane animated="false" text="Jeu">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="500.0">
                    <VBox spacing="10" layoutX="20" layoutY="20">
                        <HBox spacing="10">
                            <Label text="Jeu:" />
                            <TextField fx:id="gameField" promptText="Enter game" prefWidth="200" />
                        </HBox>
                    </VBox>
                </AnchorPane>
            </content>
        </TitledPane>

        <!-- Rank Input Section -->
        <TitledPane animated="false" text="Rang">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="500.0">
                    <VBox spacing="10" layoutX="20" layoutY="20">
                        <HBox spacing="10">
                            <Label text="Rang:" />
                            <TextField fx:id="rankField" promptText="Enter rank" prefWidth="200" />
                        </HBox>
                    </VBox>
                </AnchorPane>
            </content>
        </TitledPane>

        <!-- Status Input Section -->
        <TitledPane animated="false" text="Statut">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="500.0">
                    <VBox spacing="10" layoutX="20" layoutY="20">
                        <HBox spacing="10">
                            <Label text="Statut:" />
                            <TextField fx:id="statusField" promptText="Enter status" prefWidth="200" />
                        </HBox>
                    </VBox>
                </AnchorPane>
            </content>
        </TitledPane>

        <!-- Social Link Input Section -->
        <TitledPane animated="false" text="Lien Social">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="500.0">
                    <VBox spacing="10" layoutX="20" layoutY="20">
                        <HBox spacing="10">
                            <Label text="Lien Social:" />
                            <TextField fx:id="socialsLinkField" promptText="Enter social link" prefWidth="200" />
                        </HBox>
                    </VBox>
                </AnchorPane>
            </content>
        </TitledPane>

        <!-- Submit Button Section -->
        <TitledPane animated="false" text="Submit">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="80.0" prefWidth="500.0">
                    <VBox spacing="10" layoutX="20" layoutY="20">
                        <Button text="Ajouter l'Agent" style="-fx-background-color: #ff4747; -fx-text-fill: white;" onAction="#handleAddAgent" prefWidth="200" />
                    </VBox>
                </AnchorPane>
            </content>
        </TitledPane>

    </panes>
</Accordion>