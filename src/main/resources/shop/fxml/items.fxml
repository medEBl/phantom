<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity" prefHeight="1080" prefWidth="1920" styleClass="shop-container" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.shop.ItemsController">
   <stylesheets>
      <URL value="@/shop/css/style.css" />
   </stylesheets>

   <top>
      <VBox styleClass="shop-header">
         <children>
            <!-- Header with app title and user actions -->
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="shop-info">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="12">
                     <children>
                        <Text styleClass="shop-title" text="PHANTOM" />
                        <Text fill="#ff2d2d" styleClass="shop-title" text="FORCE" />
                        <Text styleClass="shop-title" text=" - SHOP ITEMS" />
                     </children>
                  </HBox>
                  <Region HBox.hgrow="ALWAYS" />

                  <!-- User Profile Section -->
                  <HBox alignment="CENTER" spacing="15" styleClass="user-container">
                     <children>
                        <Button fx:id="backToHomeButton" onAction="#handleBackToHome" styleClass="secondary-button" text="Back to Home" />
                        <Button fx:id="viewPaymentsButton" onAction="#handleViewPayments" styleClass="secondary-button" text="View Payments" />
                        <Button fx:id="refreshButton" onAction="#handleRefresh" styleClass="primary-button" text="Refresh" />
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <center>
      <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="shop-scroll" vbarPolicy="AS_NEEDED">
         <content>
            <VBox alignment="TOP_CENTER" spacing="30" styleClass="shop-content">
               <children>
                  <!-- Message Container -->
                  <VBox fx:id="messageContainer" alignment="CENTER" spacing="5" styleClass="message-container" />

                  <!-- Controls Section -->
                  <VBox spacing="20" styleClass="controls-container">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="15">
                           <children>
                              <Text styleClass="form-title" text="SHOP ITEMS MANAGEMENT" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button fx:id="addItemButton" onAction="#handleAddItem" styleClass="primary-button" text="Add Item" />
                           </children>
                        </HBox>

                        <!-- Action Buttons -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                           <children>
                              <Button fx:id="editItemButton" onAction="#handleEditItem" styleClass="action-button" text="Edit" />
                              <Button fx:id="deleteItemButton" onAction="#handleDeleteItem" styleClass="delete-button" text="Delete" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button fx:id="filterByCategoryButton" onAction="#handleFilterByCategory" styleClass="secondary-button" text="Filter by Category" />
                              <Button fx:id="filterInStockButton" onAction="#handleFilterInStock" styleClass="secondary-button" text="In Stock Only" />
                              <Button fx:id="showAllButton" onAction="#handleShowAll" styleClass="secondary-button" text="Show All" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Items Table -->
                  <TableView fx:id="itemsTable" prefHeight="600" styleClass="table-view">
                     <columns>
                        <TableColumn fx:id="colId" prefWidth="80" text="ID" />
                        <TableColumn fx:id="colName" prefWidth="200" text="Item Name" />
                        <TableColumn fx:id="colCategory" prefWidth="150" text="Category" />
                        <TableColumn fx:id="colPrice" prefWidth="120" text="Price" />
                        <TableColumn fx:id="colQuantity" prefWidth="100" text="Quantity" />
                        <TableColumn fx:id="colStatus" prefWidth="120" text="Status" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
