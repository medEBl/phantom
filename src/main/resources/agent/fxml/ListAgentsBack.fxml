<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox stylesheets="@../css/dark-theme.css" prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #0f0f13;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.agent.AgentListController">
    <children>

        <VBox prefWidth="250.0" spacing="40.0" style="-fx-background-color: #1a1a24; -fx-border-color: #2a2a35; -fx-border-width: 0 1 0 0;">
            <padding><Insets bottom="30.0" left="20.0" right="20.0" top="40.0" /></padding>
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="PHANTOM" textFill="#00ffff"><font><Font name="System Bold" size="24.0" /></font></Label>
                        <Label text="ADMIN PANEL" textFill="WHITE"><font><Font name="System Bold" size="14.0" /></font></Label>
                    </children>
                </VBox>

                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #2a2a35; -fx-border-color: #00ffff; -fx-border-width: 0 0 0 4; -fx-text-fill: #00ffff; -fx-alignment: CENTER_LEFT; -fx-cursor: default;" text="👥 Agents">
                            <font><Font name="System Bold" size="16.0" /></font>
                            <padding><Insets bottom="12.0" left="11.0" top="12.0" /></padding>
                        </Button>
                        <Button fx:id="btnNavQuestionnaires" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #8a8a98; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="📋 Questionnaires">
                            <font><Font size="16.0" /></font>
                            <padding><Insets bottom="12.0" left="15.0" top="12.0" /></padding>
                        </Button>
                    </children>
                </VBox>

                <Button fx:id="btnDisconnect" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #ff3b3f; -fx-cursor: hand;" text="🚪 Déconnexion">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Button>
            </children>
        </VBox>

        <VBox spacing="25.0" style="-fx-padding: 30 50 30 50;" HBox.hgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Button fx:id="btnBack" mnemonicParsing="false" style="-fx-background-color: #2a2a35; -fx-text-fill: #00ffff; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="← Back">
                            <padding><Insets bottom="10.0" left="15.0" right="15.0" top="10.0" /></padding>
                        </Button>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Gestion des Agents (Admin)" textFill="WHITE"><font><Font name="System Bold" size="24.0" /></font></Label>
                                <Label text="Supervision de tous les profils de la plateforme" textFill="#8a8a98" />
                            </children>
                        </VBox>
                        <Button fx:id="btnCreateAgent" mnemonicParsing="false" style="-fx-background-color: #00ffff; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="+ Nouveau">
                            <padding><Insets bottom="10.0" left="20.0" right="20.0" top="10.0" /></padding>
                        </Button>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #16161e; -fx-background-radius: 8; -fx-border-color: #2a2a35; -fx-border-radius: 8; -fx-padding: 5 15;" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="🔍" textFill="#8a8a98" />
                                <TextField fx:id="tfSearch" promptText="Rechercher un pseudo..." style="-fx-background-color: transparent; -fx-text-fill: white;" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <TableView fx:id="agentTable" style="-fx-background-color: #16161e; -fx-border-color: #2a2a35; -fx-border-radius: 8; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colPseudo" prefWidth="200.0" text="Pseudo" />
                        <TableColumn fx:id="colJeu" prefWidth="200.0" text="Jeu" />
                        <TableColumn fx:id="colRang" prefWidth="150.0" style="-fx-alignment: center;" text="Rang" />
                        <TableColumn fx:id="colStatut" prefWidth="150.0" style="-fx-alignment: center;" text="Statut" />
                        <TableColumn fx:id="colActions" prefWidth="200.0" style="-fx-alignment: center;" text="Actions" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

    </children>
</HBox>