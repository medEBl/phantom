<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane stylesheets="@/agent/css/agent.css" styleClass="home-container" prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.agent.AgentEditController">
    <children>
        <VBox layoutX="300.0" layoutY="50.0" prefWidth="600.0" spacing="20.0" styleClass="activity-section" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="300.0" AnchorPane.rightAnchor="300.0" AnchorPane.topAnchor="50.0">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Modifier le Profil Agent" styleClass="section-title" />
                                <Label fx:id="lblSubtitle" text="Pseudo • Game" styleClass="form-label" />
                            </children>
                        </VBox>
                        <Button fx:id="btnRetour" mnemonicParsing="false" styleClass="secondary-button" text="← Retour">
                            <padding>
                                <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
                            </padding>
                        </Button>
                    </children>
                </HBox>

                <VBox style="-fx-background-color: #1a1a24; -fx-background-radius: 6; -fx-border-color: #2a2a35; -fx-border-radius: 6;">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <Label text="⚠ Vous ne pouvez modifier que : pseudo, rang, statut, lien social." textFill="#a0a0a0" wrapText="true">
                            <font><Font size="13.0" /></font>
                        </Label>
                        <Label text="Le jeu et les autres champs sont verrouillés pour éviter les doublons." textFill="#a0a0a0" wrapText="true">
                            <font><Font size="13.0" /></font>
                        </Label>
                    </children>
                </VBox>

                <VBox spacing="15.0">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="PSEUDO / GAMER TAG" styleClass="form-label" />
                                <TextField fx:id="tfPseudo" styleClass="text-field" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="GAME (CANNOT BE CHANGED)" styleClass="form-label" />
                                <TextField fx:id="tfGame" editable="false" styleClass="text-field" style="-fx-text-fill: #8a8a98;" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="CURRENT RANK" styleClass="form-label" />
                                <TextField fx:id="tfRank" styleClass="text-field" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="STATUS" styleClass="form-label" />
                                <ComboBox fx:id="cbStatus" prefWidth="520.0" style="-fx-background-color: #1e1e28; -fx-border-color: #2a2a35; -fx-border-radius: 6; -fx-text-fill: white;" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="SOCIAL LINK (OPTIONAL)" styleClass="form-label" />
                                <TextField fx:id="tfSocials" styleClass="text-field" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="15.0" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="10.0" />
                    </padding>
                    <children>
                        <Button fx:id="btnAnnuler" mnemonicParsing="false" styleClass="secondary-button" text="Annuler">
                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                        </Button>
                        <Button fx:id="btnEnregistrer" mnemonicParsing="false" styleClass="primary-button" text="Enregistrer">
                            <padding>
                                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                            </padding>
                        </Button>
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>