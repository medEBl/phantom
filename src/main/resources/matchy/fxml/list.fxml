<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import java.net.*?>

<BorderPane styleClass="matchy-container" prefWidth="1920" prefHeight="1080" maxWidth="Infinity" maxHeight="Infinity" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.matchy.MatchyController">
   <stylesheets>
      <URL value="@/matchy/css/style.css" />
   </stylesheets>

   <top>
      <VBox styleClass="matchy-header">
         <children>
            <!-- Header with title and navigation -->
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="matchy-info">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="12">
                     <children>
                        <Text styleClass="matchy-title" text="PHANTOM" />
                        <Text styleClass="matchy-title" fill="#ff2d2d" text="MATCHY" />
                     </children>
                  </HBox>
                  <Region HBox.hgrow="ALWAYS" />
                  
                  <!-- Navigation back to home -->
                  <Button fx:id="backButton" onAction="#handleBackToHome" styleClass="secondary-button" text="Back to Home" />
               </children>
            </HBox>

            <!-- Controls Bar -->
            <HBox alignment="CENTER_LEFT" spacing="15" styleClass="matchy-controls">
               <children>
                  <TextField fx:id="searchField" promptText="Search matches..." styleClass="search-field" prefWidth="300" />
                  <ComboBox fx:id="gameFilterComboBox" prefWidth="200" styleClass="filter-combo" />
                  <ComboBox fx:id="statusFilterComboBox" prefWidth="150" styleClass="filter-combo" />
                  <Region HBox.hgrow="ALWAYS" />
                  
                  <Button fx:id="createMatchButton" onAction="#handleCreateMatch" styleClass="primary-button" text="Create Match" />
                  <Button fx:id="editMatchButton" onAction="#handleEditMatch" styleClass="secondary-button" text="Edit" disable="true" />
                  <Button fx:id="deleteMatchButton" onAction="#handleDeleteMatch" styleClass="danger-button" text="Delete" disable="true" />
                  <Button fx:id="refreshButton" onAction="#handleRefresh" styleClass="secondary-button" text="Refresh" />
               </children>
            </HBox>
            
            <!-- Stats Bar -->
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="matchy-stats">
               <children>
                  <Label fx:id="totalMatchesLabel" styleClass="stat-label" text="Total Matches: 0" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Text styleClass="help-text" text="Double-click a row to view match details" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <center>
      <ScrollPane styleClass="matchy-scroll" fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
         <content>
            <VBox alignment="CENTER" spacing="20" styleClass="matchy-content">
               <children>
                  <TableView fx:id="matchyTableView" styleClass="matchy-table" onMouseClicked="#handleViewMatch">
                     <columns>
                           <TableColumn fx:id="idColumn" text="ID" prefWidth="60" />
                           <TableColumn fx:id="gameColumn" text="Game" prefWidth="120" />
                           <TableColumn fx:id="matchDateColumn" text="Date  Time" prefWidth="160" />
                           <TableColumn fx:id="statusColumn" text="Status" prefWidth="100" />
                           <TableColumn fx:id="team1Column" text="Team 1" prefWidth="150" />
                           <TableColumn fx:id="team2Column" text="Team 2" prefWidth="150" />
                           <TableColumn fx:id="score1Column" text="Score 1" prefWidth="80" />
                           <TableColumn fx:id="score2Column" text="Score 2" prefWidth="80" />
                     </columns>
                     <columnResizePolicy>
                           <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
