<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import java.net.*?>

<BorderPane styleClass="coach-container" prefWidth="1920" prefHeight="1080" maxWidth="Infinity" maxHeight="Infinity" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.trainingplan.ListTrainingPlansController">
   <stylesheets>
      <URL value="@/coach/css/style.css" />
   </stylesheets>
   
   <top>
      <VBox styleClass="coach-header">
         <children>
            <!-- Training Plans Header -->
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="coach-info">
               <children>
                  <Button fx:id="backButton" onAction="#handleBack" styleClass="primary-button" text="← BACK TO HOME" />
                  <Text styleClass="coach-title" text="TRAINING PLANS" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="currentUserLabel" styleClass="user-label" text="USER: LOADING..." />
               </children>
            </HBox>
            
            <!-- Filters Section -->
            <HBox alignment="CENTER_LEFT" spacing="15" styleClass="filter-section">
               <children>
                  <TextField fx:id="searchField" promptText="Search training plans..." styleClass="search-field" prefWidth="200" />
                  <ComboBox fx:id="coachFilter" styleClass="filter-combo" prefWidth="120" />
                  <ComboBox fx:id="teamFilter" styleClass="filter-combo" prefWidth="120" />
                  <ComboBox fx:id="difficultyFilter" styleClass="filter-combo" prefWidth="120" />
                  <ComboBox fx:id="focusAreaFilter" styleClass="filter-combo" prefWidth="120" />
                  <Button fx:id="searchButton" onAction="#handleSearch" styleClass="secondary-button" text="Search" />
                  <Button fx:id="clearButton" onAction="#handleClear" styleClass="secondary-button" text="Clear" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="addPlanButton" onAction="#handleAddPlan" styleClass="primary-button" text="+ NEW PLAN" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   
   <center>
      <VBox spacing="10" styleClass="coach-content">
         <children>
            <!-- Training Plans Table -->
            <TableView fx:id="plansTable" styleClass="coach-table" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="idColumn" text="ID" prefWidth="50" />
                  <TableColumn fx:id="titleColumn" text="Title" prefWidth="200" />
                  <TableColumn fx:id="coachColumn" text="Coach" prefWidth="150" />
                  <TableColumn fx:id="teamColumn" text="Team" prefWidth="150" />
                  <TableColumn fx:id="focusAreaColumn" text="Focus Area" prefWidth="120" />
                  <TableColumn fx:id="difficultyColumn" text="Difficulty" prefWidth="100" />
                  <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="150" />
               </columns>
            </TableView>
            
            <!-- Pagination -->
            <HBox alignment="CENTER" spacing="15" styleClass="pagination-section">
               <children>
                  <Button fx:id="prevPageButton" onAction="#handlePrevPage" styleClass="secondary-button" text="← Previous" />
                  <Label fx:id="pageInfoLabel" styleClass="page-info" text="Page 1 of 1" />
                  <Button fx:id="nextPageButton" onAction="#handleNextPage" styleClass="secondary-button" text="Next →" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
