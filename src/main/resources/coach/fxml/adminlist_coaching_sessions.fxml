<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import java.net.*?>

<BorderPane styleClass="coach-container" prefWidth="1920" prefHeight="1080" maxWidth="Infinity" maxHeight="Infinity" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.coachingsession.AdminListCoachingSessionController">
    <stylesheets>
        <URL value="@/coach/css/style.css" />
    </stylesheets>

    <top>
        <VBox styleClass="coach-header">
            <children>
                <!-- Admin List Header -->
                <HBox alignment="CENTER_LEFT" spacing="20" styleClass="coach-info">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <children>
                                <Text styleClass="coach-title" text="ADMIN" />
                                <Text styleClass="coach-title" fill="#ff2d2d" text="COACHING SESSIONS LIST" />
                            </children>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="currentUserLabel" styleClass="user-label" text="ADMIN: LOADING..." />
                        <Button fx:id="backButton" onAction="#handleBack" styleClass="back-button" text="BACK TO BACKOFFICE" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" styleClass="coach-content" alignment="TOP_CENTER">
            <children>
                <!-- Statistics Cards - CORRIGÉ: Text changé en Label -->
                <HBox spacing="20" alignment="CENTER_LEFT" styleClass="stats-container">
                    <children>
                        <VBox styleClass="stat-card" alignment="CENTER" spacing="10">
                            <children>
                                <Label styleClass="stat-number" fx:id="totalSessionsLabel" text="0" />
                                <Text styleClass="stat-label" text="TOTAL SESSIONS" />
                            </children>
                        </VBox>
                        <VBox styleClass="stat-card" alignment="CENTER" spacing="10">
                            <children>
                                <Label styleClass="stat-number" fx:id="upcomingSessionsLabel" text="0" />
                                <Text styleClass="stat-label" text="UPCOMING" />
                            </children>
                        </VBox>
                        <VBox styleClass="stat-card" alignment="CENTER" spacing="10">
                            <children>
                                <Label styleClass="stat-number" fx:id="completedSessionsLabel" text="0" />
                                <Text styleClass="stat-label" text="COMPLETED" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="addSessionButton" onAction="#handleAddSession" styleClass="action-button" text="CREATE NEW" />
                    </children>
                </HBox>

                <!-- Filters Section -->
                <VBox spacing="15" styleClass="filter-section">
                    <children>
                        <Text styleClass="section-title" text="FILTERS And SEARCH" />

                        <HBox spacing="15" alignment="CENTER_LEFT">
                            <children>
                                <VBox spacing="5">
                                    <children>
                                        <Text styleClass="filter-label" text="Coach:" />
                                        <ComboBox fx:id="coachFilter" styleClass="text-field" />
                                    </children>
                                </VBox>

                                <VBox spacing="5">
                                    <children>
                                        <Text styleClass="filter-label" text="Team:" />
                                        <ComboBox fx:id="teamFilter" styleClass="text-field" />
                                    </children>
                                </VBox>

                                <VBox spacing="5">
                                    <children>
                                        <Text styleClass="filter-label" text="Status:" />
                                        <ComboBox fx:id="statusFilter" styleClass="text-field" />
                                    </children>
                                </VBox>

                                <VBox spacing="5">
                                    <children>
                                        <Text styleClass="filter-label" text="Search:" />
                                        <TextField fx:id="searchField" promptText="Search sessions..." styleClass="text-field" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <children>
                                <Button fx:id="searchButton" onAction="#handleSearch" styleClass="action-button" text="SEARCH" />
                                <Button fx:id="clearFiltersButton" onAction="#handleClear" styleClass="action-button" text="CLEAR FILTERS" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Sessions Table -->
                <VBox spacing="15" styleClass="table-section" VBox.vgrow="ALWAYS">
                    <children>
                        <Text styleClass="section-title" text="COACHING SESSIONS LIST" />

                        <TableView fx:id="sessionsTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="idColumn" text="ID" prefWidth="60" />
                                <TableColumn fx:id="coachColumn" text="Coach" prefWidth="150" />
                                <TableColumn fx:id="teamColumn" text="Team" prefWidth="150" />
                                <TableColumn fx:id="dateColumn" text="Date And Time" prefWidth="180" />
                                <TableColumn fx:id="durationColumn" text="Duration" prefWidth="100" />
                                <TableColumn fx:id="trainingPlanColumn" text="Training Plan" prefWidth="200" />
                                <TableColumn fx:id="statusColumn" text="Status" prefWidth="100" />
                                <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="250" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <!-- Pagination -->
                        <HBox alignment="CENTER" spacing="10">
                            <children>
                                <Button fx:id="prevPageButton" onAction="#handlePrevPage" styleClass="secondary-button" text="PREVIOUS" />
                                <Label fx:id="pageInfoLabel" styleClass="page-info" text="Page 1 of 1" />
                                <Button fx:id="nextPageButton" onAction="#handleNextPage" styleClass="secondary-button" text="NEXT" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>