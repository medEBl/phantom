<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import java.net.*?>
<?import javafx.geometry.Insets?>

<BorderPane styleClass="dashboard-container" prefWidth="1920" prefHeight="1080" maxWidth="Infinity" maxHeight="Infinity" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.tournament.TournamentFormController">
   <stylesheets>
      <URL value="@/dashboard/css/dashboard.css" />
   </stylesheets>
   
   <top>
      <VBox styleClass="dashboard-header">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="dashboard-info">
               <children>
                  <Button fx:id="backButton" onAction="#handleCancel" styleClass="logout-button" text="🔙 CANCEL" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Text fx:id="formTitle" styleClass="dashboard-title" text="🏆 TOURNAMENT" />
                  <Text fx:id="formSubtitle" styleClass="dashboard-title" fill="#ff2d2d" text="FORM" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label styleClass="admin-label" text="ADMIN: SYSTEM" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true" styleClass="dashboard-scroll" hbarPolicy="NEVER">
         <content>
            <VBox alignment="TOP_CENTER" spacing="30" styleClass="dashboard-content">
               <children>
                  <VBox maxWidth="800" spacing="25" styleClass="activity-section" style="-fx-padding: 40;">
                     <children>
                        <Text fx:id="sectionTitle" styleClass="section-title" text="NEW TOURNAMENT DETAILS" />
                        
                        <GridPane hgap="30" vgap="20">
                           <columnConstraints>
                              <ColumnConstraints percentWidth="50" />
                              <ColumnConstraints percentWidth="50" />
                           </columnConstraints>
                           
                           <children>
                              <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                 <children>
                                    <Label styleClass="form-label" text="Tournament Name" />
                                    <TextField fx:id="nameField" promptText="Enter tournament name" styleClass="text-field" />
                                 </children>
                              </VBox>
                              
                              <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                 <children>
                                    <Label styleClass="form-label" text="Game" />
                                    <TextField fx:id="gameField" promptText="e.g. League of Legends" styleClass="text-field" />
                                 </children>
                              </VBox>
                              
                              <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                 <children>
                                    <Label styleClass="form-label" text="Start Date" />
                                    <DatePicker fx:id="startDatePicker" promptText="Select start date" styleClass="text-field" prefWidth="Infinity" />
                                 </children>
                              </VBox>
                              
                              <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                 <children>
                                    <Label styleClass="form-label" text="End Date" />
                                    <DatePicker fx:id="endDatePicker" promptText="Select end date" styleClass="text-field" prefWidth="Infinity" />
                                 </children>
                              </VBox>
                              
                              <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                 <children>
                                    <Label styleClass="form-label" text="Phase" />
                                    <ComboBox fx:id="phaseCombo" promptText="Select phase" styleClass="text-field" prefWidth="Infinity" />
                                 </children>
                              </VBox>
                              
                              <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                 <children>
                                    <Label styleClass="form-label" text="Max Teams" />
                                    <TextField fx:id="maxTeamsField" promptText="e.g. 16" styleClass="text-field" />
                                 </children>
                              </VBox>
                              
                              <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                 <children>
                                    <Label styleClass="form-label" text="Organizer ID" />
                                    <TextField fx:id="organizerIdField" promptText="Enter organizer ID" styleClass="text-field" />
                                 </children>
                              </VBox>
                              
                              <HBox alignment="CENTER_LEFT" spacing="15" GridPane.columnIndex="1" GridPane.rowIndex="3" style="-fx-padding: 25 0 0 0;">
                                 <children>
                                    <CheckBox fx:id="activeCheck" text="ACTIVE TOURNAMENT" styleClass="form-label" style="-fx-text-fill: white;" />
                                 </children>
                              </HBox>
                           </children>
                        </GridPane>
                        
                        <Separator />
                        
                        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20 0 0 0;">
                           <children>
                              <Button fx:id="manageRewardsBtn" onAction="#handleManageRewards" styleClass="secondary-button" text="🎁 MANAGE REWARDS" prefWidth="200" visible="false" />
                              <Button onAction="#handleCancel" styleClass="secondary-button" text="❌ CANCEL" prefWidth="150" />
                              <Button onAction="#handleSave" styleClass="action-button" text="💾 SAVE TOURNAMENT" prefWidth="250" />
                           </children>
                        </HBox>
                        
                        <Label fx:id="errorLabel" styleClass="error-label" text="" visible="false" alignment="CENTER" maxWidth="Infinity" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
