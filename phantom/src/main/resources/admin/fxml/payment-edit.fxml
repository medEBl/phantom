<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<?import java.net.URL?>
<BorderPane styleClass="admin-container" prefWidth="1920" prefHeight="1080" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.admin.AdminEditPaymentController">
   <stylesheets>
      <URL value="@/admin/css/admin.css" />
   </stylesheets>

   <top>
      <VBox styleClass="admin-header">
         <children>
            <!-- Admin Header -->
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="admin-info">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10">
                     <children>
                        <Text styleClass="admin-title" text="💳 EDIT PAYMENT" />
                        <Text styleClass="admin-subtitle" text="UPDATE PAYMENT" />
                     </children>
                  </HBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="backButton" onAction="#handleBack" styleClass="back-button" text="🔙 BACK TO PAYMENTS" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <center>
      <VBox spacing="30" alignment="CENTER" styleClass="form-container">
         <children>
            <!-- Form Title -->
            <Text styleClass="form-title" text="EDIT PAYMENT" />

            <!-- Payment Form -->
            <GridPane hgap="20" vgap="15" alignment="CENTER" maxWidth="600">
               <children>
                  <!-- ID Field (Readonly) -->
                  <Label text="Payment ID:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                  <TextField fx:id="idField" editable="false" styleClass="form-input readonly" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                  <!-- Amount Field -->
                  <Label text="Amount (DT):" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                  <TextField fx:id="amountField" promptText="Enter new amount (optional)" styleClass="form-input" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                  <!-- Method Field -->
                  <Label text="Payment Method:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                  <TextField fx:id="methodField" promptText="card, cash, paypal, bank_transfer, crypto, check" styleClass="form-input" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                  <!-- Status Field -->
                  <Label text="Payment Status:" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                  <TextField fx:id="statusField" promptText="pending, success, failed, refunded, cancelled" styleClass="form-input" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                  <!-- Transaction Reference Field (Readonly) -->
                  <Label text="Transaction Reference:" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                  <TextField fx:id="transactionRefField" editable="false" styleClass="form-input readonly" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                  <!-- Shop Item ID Field -->
                  <Label text="Shop Item ID:" styleClass="form-label" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                  <TextField fx:id="shopItemIdField" promptText="Enter new shop item ID (optional)" styleClass="form-input" GridPane.rowIndex="5" GridPane.columnIndex="1" />
               </children>
            </GridPane>

            <!-- Form Buttons -->
            <HBox spacing="20" alignment="CENTER">
               <children>
                  <Button fx:id="saveButton" onAction="#handleUpdatePayment" styleClass="primary-button" text="💾 UPDATE PAYMENT" prefWidth="150" />
                  <Button fx:id="cancelButton" onAction="#handleCancel" styleClass="secondary-button" text="🚫 CANCEL" prefWidth="150" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
