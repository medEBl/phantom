<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import java.net.*?>
<?import javafx.scene.layout.Region?>

<BorderPane styleClass="dashboard-container" prefWidth="1920" prefHeight="1080" maxWidth="Infinity" maxHeight="Infinity" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.tournament.TournamentRewardManagementController">
   <stylesheets>
      <URL value="@/dashboard/css/dashboard.css" />
   </stylesheets>
   
   <top>
      <VBox styleClass="dashboard-header">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="dashboard-info">
               <children>
                  <Button fx:id="backButton" onAction="#handleBack" styleClass="logout-button" text="🔙 BACK TO TOURNAMENT" />
                  <Region HBox.hgrow="ALWAYS" />
                  <VBox alignment="CENTER">
                     <children>
                        <HBox alignment="CENTER" spacing="10">
                           <children>
                              <Text styleClass="dashboard-title" text="🎁 REWARD" />
                              <Text styleClass="dashboard-title" fill="#ff2d2d" text="MANAGEMENT" />
                           </children>
                        </HBox>
                        <Label fx:id="tournamentNameLabel" styleClass="form-label" text="Tournament: loading..." />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label styleClass="admin-label" text="ADMIN: SYSTEM" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true" styleClass="dashboard-scroll" hbarPolicy="NEVER">
         <content>
            <VBox spacing="25" styleClass="dashboard-content">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Text styleClass="section-title" text="📋 TOURNAMENT REWARDS" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleAddReward" styleClass="action-button" text="➕ ADD REWARD" />
                     </children>
                  </HBox>
                  
                  <TableView fx:id="rewardTable" styleClass="activity-table" prefHeight="600">
                     <columns>
                        <TableColumn fx:id="rankColumn" text="Rank" prefWidth="100" />
                        <TableColumn fx:id="typeColumn" text="Reward Type" prefWidth="250" />
                        <TableColumn fx:id="valueColumn" text="Value" prefWidth="300" />
                        <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="200" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
